{
  "name": "@genesis-worlds/runtime",
  "version": "0.1.0",
  "description": "Open source World Model engine. Build infinite experiences and worldstreams with memory, inventory, shared rules and custom interfaces.",
  "homepage": "https://sequencer.media/genesis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sequencer-media/genesis.git"
  },
  "bugs": {
    "url": "https://github.com/sequencer-media/genesis/issues"
  },
  "keywords": [
    "world-models",
    "world-model-engine",
    "generative-video",
    "ai-worlds",
    "worldstreams",
    "llm",
    "sdk",
    "multiplayer",
    "sequencer"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "schema",
    "scripts",
    "skills",
    "SECURITY.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "bin": {
    "genesis": "./dist/cli.js"
  },
  "scripts": {
    "play": "node scripts/play.mjs",
    "build": "tsc && node scripts/write-schema.mjs",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "dev": "npm run build && node dist/cli.js dev examples/exploration",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:dev": "npm run docs:build && node scripts/serve-docs.mjs",
    "check": "npm test && npm run docs:build && npm pack --dry-run",
    "serve:world": "npm run build && node examples/server/server.mjs",
    "mcp:world": "node examples/server/mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "fflate": "0.8.3",
    "quickjs-emscripten": "0.31.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "marked": "13.0.3",
    "typescript": "^5.7.0"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  },
  "private": true
}
